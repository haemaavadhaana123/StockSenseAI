modules = ["python-3.11"]

run = "python -m streamlit run app.py --server.address 0.0.0.0 --server.port 5000 --browser.serverAddress \"$REPLIT_DEV_DOMAIN\""



[nix]
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m streamlit run app.py --server.address 0.0.0.0 --server.port 5000 --browser.serverAddress \"$REPLIT_DEV_DOMAIN\""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8501
externalPort = 3000
